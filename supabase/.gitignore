@'
# Dependencies
node_modules/

# Production builds
dist/
build/

# Environment variables and secrets
.env
.env.*
!.env.example

# Supabase local temporary files
supabase/.temp/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor
.vscode/*
!.vscode/extensions.json
.idea/

# Test and coverage output
coverage/

# Temporary files
*.tmp
*.bak
'@ | Set-Content -Encoding utf8 .gitignore